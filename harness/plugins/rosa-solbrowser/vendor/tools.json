   "properties": {}
  }
 },
 {
  "name": "attach",
  "description": "Attach a tab (default: the active tab) and make it current. Usually unnecessary: tools auto-attach.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "tabId": {
     "description": "Tab to attach. Omit for the active tab.",
