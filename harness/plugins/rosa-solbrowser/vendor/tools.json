   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "tabs",
  "description": "Manage tabs: list, new (opens url and makes it current), close, select (make current; attaches).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "action": {
     "type": "string",
     "enum": [
      "list",
      "new",
      "close",
      "select"
     ]
    },
    "url": {
     "description": "For new (default about:blank).",
     "type": "string"
    },
    "tabId": {
     "description": "For close/select (default: current tab).",
     "type": "integer",
     "minimum": -9007199254740991,
     "maximum": 9007199254740991
    },
    "force": {
     "description": "select: take a tab another session uses.",
     "type": "boolean"
    },
    "background": {
     "description": "new: open without focusing it (it still becomes current).",
     "type": "boolean"
    }
   },
   "required": [
    "action"
   ],
   "additionalProperties": {}
  }
 },
 {
  "name": "list_tabs",
